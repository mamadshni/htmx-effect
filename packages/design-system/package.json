{
  "name": "@combo/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./*"
  },
  "files": [
    "./bundle"
  ],
  "scripts": {
    "clean": "rm -rf bundle",
    "build": "pnpm run clean && pnpm run build:bundle && pnpm run build:types",
    "build:bundle": "esbuild src/index.ts src/index.css --bundle --format=iife --target=es2022 --sourcemap --outdir=bundle",
    "build:types": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
