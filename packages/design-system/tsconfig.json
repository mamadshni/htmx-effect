{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],

    // tsc only emits types; esbuild bundles the JS and CSS (see package.json)
    "rootDir": "src",
    "outDir": "bundle",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true
  },
  "include": ["src"]
}
